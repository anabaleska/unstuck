# PostgreSQL connection string.
# Neon: copy it from the dashboard ("Connect" button). It already includes ?sslmode=require.
# Local Postgres example: postgres://postgres:postgres@localhost:5432/unstuck
DATABASE_URL=

# Separate database used only by `npm test` (tests wipe their tables!).
# Tip: on Neon, create a second branch or database for this.
TEST_DATABASE_URL=

# Frontend origin(s) allowed to call the API, comma separated.
CORS_ORIGIN=http://localhost:5173

PORT=3000

# Optional: Gemini API key from https://aistudio.google.com (free tier).
# Without it, the app still works; it just skips the AI session brief.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-3.5-flash-lite)
GEMINI_MODEL=
